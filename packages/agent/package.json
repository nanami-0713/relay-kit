{
  "name": "@hsinsekai-nanami/agent",
  "version": "0.2.2",
  "description": "Desktop-side relay agent: outbound WS to the relay, tunnels HTTP/WS frames to a local port",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "relay-agent": "dist/cli.js"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nanami-0713/relay-kit.git",
    "directory": "packages/agent"
  },
  "bugs": "https://github.com/nanami-0713/relay-kit/issues",
  "homepage": "https://github.com/nanami-0713/relay-kit#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@hsinsekai-nanami/core": "^0.2.2",
    "https-proxy-agent": "^9.1.0",
    "ws": "^8.18.0"
  },
  "license": "MIT"
}
